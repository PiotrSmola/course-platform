# Copy this file to .env in the project root (next to docker-compose.yml).
# .env is gitignored and never committed.

# Required — at least 32 characters. Generate your own value; do not use the placeholder below.
JWT_KEY=k8#mP2xL9vQn4wR7tY0zA3bC6dE1fG5hJ8

# Optional — JWT lifetime in minutes (default: 120)
JWT_EXPIRY_MINUTES=120

# MinIO (Etap 2)
# Credentials used by the API (and minio_init container). Change for real projects.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# Bucket name used by the application
MINIO_BUCKET=course-platform

# Public MinIO endpoint accessible from the browser (dev)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Elasticsearch (Search)
ELASTIC_ENABLED=true
ELASTIC_COURSE_INDEX_NAME=courseplatform-courses

# Stripe test mode (Etap 3)
# Secret key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_).
# Webhook secret is printed by stripe_cli on startup (starts with whsec_) — see README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recipient address for messages submitted through the public contact form.
SUPPORT_INBOX_ADDRESS=support@courseplatform.local
